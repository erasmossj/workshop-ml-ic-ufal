# Copie para .env (que NÃO é versionado) e preencha. Nunca commite valores reais.
# Conta Gmail do evento + senha de app (Conta Google > Segurança > Senhas de app; exige 2FA).
GMAIL_USER=evento@exemplo.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Site (variáveis PUBLIC_ vão para o navegador — só valores públicos!).
# Sem PUBLIC_SUPABASE_URL o formulário roda em modo demonstração (nada é gravado).
# Local: valores de `npx supabase status` (API_URL e ANON_KEY).
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
# Chave de site do Turnstile. Teste pública da Cloudflare (sempre aprova): 1x00000000000000000000AA
PUBLIC_TURNSTILE_SITE_KEY=
