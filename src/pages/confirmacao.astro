---
import { dias, eventosDeAgenda } from '../data/evento';
import Base from '../layouts/Base.astro';
import { googleCalendarUrl } from '../lib/agenda';

const agenda = eventosDeAgenda().map((e, i) => ({
  dia: dias[i].semana,
  url: googleCalendarUrl(e),
}));
---

<Base title="Inscrição confirmada" description="Comprovante de inscrição no IC-ML 2026.">
  <div class="mx-auto max-w-3xl px-5 py-12 md:px-10 md:py-16">
    <article class="border-2 border-tinta bg-papel p-6 md:p-10" aria-labelledby="ok-t">
      <p class="rotulo text-laranja-texto">Comprovante · IC-ML 2026</p>
      <h1 id="ok-t" class="mt-3 font-display text-5xl leading-none font-black md:text-6xl">
        Inscrição confirmada.
      </h1>
      <p class="mt-4 text-cinza">
        Enviamos o comprovante para{' '}
        <strong id="c-email" class="text-tinta">
          voce@exemplo.com
        </strong>
        . Não chegou? Confira a caixa de spam.
      </p>

      <div class="mt-8 grid gap-6 border-y-2 border-tinta py-6 sm:grid-cols-[1fr_auto] sm:items-center">
        <div>
          <p class="rotulo text-cinza">Número de inscrição</p>
          <p id="c-numero" class="mt-1 font-mono text-4xl font-semibold text-laranja-texto">
            ICML26-0042
          </p>
        </div>
        <figure class="justify-self-start bg-white p-2 sm:justify-self-end">
          <div
            id="c-qr"
            class="size-32"
            role="img"
            aria-label="QR Code da inscrição para o credenciamento"
          ></div>
          <figcaption class="sr-only">Apresente este QR Code no credenciamento.</figcaption>
        </figure>
      </div>

      <dl class="mt-6 grid gap-3">
        {[
          ['Participante', 'c-nome', 'Participante Exemplo'],
          ['CPF', 'c-cpf', '***.982.247-**'],
          ['Palestras e apresentações', null, '02, 03 e 04/12 — todas'],
          ['Minicurso', 'c-minicurso', 'Não inscrito'],
          ['Trabalho', 'c-trabalho', 'Não submetido'],
        ].map(([rotulo, id, valor]) => (
          <div class="flex flex-col justify-between gap-1 sm:flex-row sm:gap-6">
            <dt class="text-cinza">{rotulo}</dt>
            <dd id={id ?? undefined} class="font-semibold sm:text-right">
              {valor}
            </dd>
          </div>
        ))}
      </dl>

      <div class="no-print mt-8 flex flex-col gap-3 sm:flex-row">
        <button type="button" id="imprimir" class="btn-primario">
          Salvar comprovante (PDF)
        </button>
        <button type="button" id="baixar-ics" class="btn-secundario">
          Adicionar à agenda (.ics)
        </button>
      </div>
      <p class="no-print mt-4 text-sm text-cinza">
        Ou no Google Agenda:{' '}
        {agenda.map((a, i) => (
          <>
            {i > 0 && ' · '}
            <a
              href={a.url}
              target="_blank"
              rel="noopener noreferrer"
              class="font-semibold text-tinta underline underline-offset-4"
            >
              {a.dia}
            </a>
          </>
        ))}
      </p>
      <p class="mt-6 text-sm text-cinza">Apresente o QR Code no credenciamento de cada dia.</p>
    </article>
  </div>
</Base>

<script>
  import QRCode from 'qrcode';
  import { eventosDeAgenda } from '../data/evento';
  import { gerarIcs } from '../lib/agenda';
  import { carregarDemo } from '../lib/demo';

  const dados = carregarDemo();
  const texto = (id: string, valor: string) => {
    const el = document.getElementById(id);
    if (el) el.textContent = valor;
  };

  if (dados) {
    texto('c-numero', dados.numero);
    texto('c-email', dados.email);
    texto('c-nome', dados.nome);
    texto('c-cpf', dados.cpfMascarado);
    texto('c-minicurso', dados.minicurso ? 'Inscrito — 3 tardes' : 'Não inscrito');
    texto(
      'c-trabalho',
      dados.trabalho
        ? `Enviado · aguardando avaliação${dados.trabalho.premio ? ' · concorrendo ao prêmio' : ''}`
        : 'Não submetido',
    );
  }

  // Na versão real o QR carrega um token assinado (HMAC), não só o número.
  const numero = document.getElementById('c-numero')!.textContent ?? '';
  QRCode.toString(numero, {
    type: 'svg',
    margin: 1,
    color: { dark: '#141414', light: '#ffffff' },
  }).then((svg) => {
    document.getElementById('c-qr')!.innerHTML = svg;
  });

  document.getElementById('imprimir')!.addEventListener('click', () => window.print());
  document.getElementById('baixar-ics')!.addEventListener('click', () => {
    const blob = new Blob([gerarIcs(eventosDeAgenda())], { type: 'text/calendar;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const a = Object.assign(document.createElement('a'), { href: url, download: 'ic-ml-2026.ics' });
    a.click();
    URL.revokeObjectURL(url);
  });
</script>
