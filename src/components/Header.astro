---
const links = [
  { href: '/#sobre', label: 'Sobre' },
  { href: '/#programacao', label: 'Programação' },
  { href: '/#minicurso', label: 'Minicurso' },
  { href: '/#trabalhos', label: 'Trabalhos' },
  { href: '/#faq', label: 'FAQ' },
];
---

<header class="no-print sticky top-0 z-40 border-b border-white/10 bg-fundo-1/70 backdrop-blur-lg">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-5 py-3 md:px-10">
    <!-- Sem aria-label: o nome acessível começa pelo texto visível (WCAG 2.5.3, comando de voz). -->
    <a href="/" class="flex items-center gap-3">
      <span
        class="grid size-10 place-items-center rounded-xl bg-linear-to-br from-acao-1 to-acao-2 font-display text-sm font-extrabold text-sobre-acao"
        aria-hidden="true"
      >
        ML
      </span>
      <span class="leading-tight">
        <span class="block text-xs text-suave">Workshop de</span>
        <span class="font-display text-base font-bold">Machine Learning</span>
        <span class="sr-only"> (página inicial)</span>
      </span>
    </a>

    <nav aria-label="Principal" class="hidden items-center gap-7 lg:flex">
      {links.map((l) => (
        <a href={l.href} class="text-sm font-medium text-suave transition hover:text-texto">
          {l.label}
        </a>
      ))}
      <a href="/inscricao" class="btn-primario px-5 py-2.5">
        Inscreva-se
      </a>
    </nav>

    <details class="relative lg:hidden">
      <summary class="flex cursor-pointer list-none items-center gap-2 rounded-full border border-white/30 px-4 py-2 [&::-webkit-details-marker]:hidden">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2"></path>
        </svg>
        <span class="text-sm font-medium">Menu</span>
      </summary>
      <nav
        aria-label="Principal (celular)"
        class="absolute right-0 mt-2 flex w-60 flex-col rounded-2xl border border-white/20 bg-fundo-1 p-2 shadow-2xl"
      >
        {links.map((l) => (
          <a href={l.href} class="rounded-xl px-3 py-2.5 font-medium hover:bg-white/10">
            {l.label}
          </a>
        ))}
        <a href="/inscricao" class="btn-primario mt-2">
          Inscreva-se
        </a>
      </nav>
    </details>
  </div>
</header>
