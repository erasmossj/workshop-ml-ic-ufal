# Copie para supabase/functions/.env (NÃO versionado) para rodar as funções localmente.
# Em produção, defina os mesmos nomes com `supabase secrets set` — nunca no repositório.
# SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY são injetadas automaticamente pelo Supabase.

# Chave secreta de TESTE pública da Cloudflare (sempre aprova). Em produção, use a chave real.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Origens do site que podem chamar a função (CORS), separadas por vírgula.
# Aceita `*` dentro de um rótulo (só https), para os previews da Vercel — use APENAS no staging.
# Produção: só a origem exata do site oficial.
ALLOWED_ORIGINS=http://localhost:4321,http://127.0.0.1:4321,https://workshop-ml-ic-ufal-*-erasmo-junior.vercel.app
# Sal do hash do IP no limite de requisições (o IP nunca é guardado puro).
RATE_LIMIT_SALT=sal-local-de-desenvolvimento
# Tentativas por origem a cada 10 minutos (produção: 10).
RATE_LIMIT_MAX=5

# --- send-emails (fila de e-mail) ---
# Segredo do cabeçalho x-cron-secret (≥ 32 caracteres). O MESMO valor vai no Vault do banco
# (send_emails_secret). Local: já está no seed.sql. Remoto: gere com `openssl rand -hex 32`.
SEND_EMAILS_SECRET=segredo-local-do-cron-de-desenvolvimento-0001
# Assina o token do QR do comprovante (≥ 32 caracteres). Remoto: `openssl rand -hex 32`.
QR_HMAC_SECRET=segredo-local-do-qr-code-de-desenvolvimento-01
# Remetente. Remoto: o Gmail do evento + senha de app (16 letras) em GMAIL_APP_PASSWORD.
GMAIL_USER=icml2026@exemplo.com
GMAIL_APP_PASSWORD=
# Local: Mailpit do Supabase (veja em http://127.0.0.1:54324). Remoto: não defina (usa smtp.gmail.com:465).
SMTP_HOST=inbucket
SMTP_PORT=1025
# Reserva opcional: chave da API do Brevo e remetente verificado lá (padrão: GMAIL_USER).
BREVO_API_KEY=
# E-mails por execução (o cron roda a cada minuto; o teto diário fica em config_evento).
EMAIL_LOTE=10
# Link do site no e-mail (opcional).
SITE_URL=http://localhost:4321
