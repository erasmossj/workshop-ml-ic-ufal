---
import Deteccao from '../components/Deteccao.astro';
import FormInscricao from '../components/FormInscricao.astro';
import Header from '../components/Header.astro';
import ItemProgramacao from '../components/ItemProgramacao.astro';
import LogoConjunto from '../components/LogoConjunto.astro';
import Painel from '../components/Painel.astro';
import Seta from '../components/Seta.astro';
import Titulo from '../components/Titulo.astro';
import { cronograma, dias, evento, faq, janela, minicurso, trabalhos } from '../data/evento';
import Base from '../layouts/Base.astro';

const palestras = [
  {
    quando: 'Qua · 02.12 · 10h00',
    titulo: 'Palestra de abertura',
    quem: 'Pesquisador convidado — a confirmar',
  },
  {
    quando: 'Sex · 04.12 · 11h00',
    titulo: 'ML e ciência de dados no mercado',
    quem: 'Convidado do setor — a confirmar',
  },
];

const secao = 'mx-auto max-w-7xl px-4 py-20 md:px-16 md:py-24';
---

<Base semCabecalho>
  <!-- HERO (Figma: Aplicações › Hero — site oficial 1280×720) -->
  <div class="grid border-b border-line-100 lg:grid-cols-[1fr_26.25rem]">
    <!-- O fundo acompanha a altura da coluna do formulário; o conteúdo fica fixo na rolagem. -->
    <div class="border-line-100 bg-bg-100 lg:border-r">
      <div class="flex flex-col justify-between gap-16 px-4 py-8 md:px-16 lg:sticky lg:top-0 lg:h-dvh lg:min-h-[45rem]">
        <Header embutido />

        <section aria-labelledby="titulo-evento" class="flex flex-col items-start">
          <p class="rotulo whitespace-pre-wrap text-lime-ink">{evento.hero.linha.join('  ·  ')}</p>
          <h1 id="titulo-evento" class="mt-6 display-hero text-ink-100">
            <span class="block">Workshop de</span>
            <span class="flex flex-wrap items-end gap-x-5.5">
              <span>Machine</span>
              <Deteccao classe="class: ML" confianca="0.98">
                Learning
              </Deteccao>
            </span>
          </h1>
          <p class="mt-6 max-w-[29.375rem] body-l text-ink-200">{evento.hero.texto}</p>
          <div class="mt-8 flex w-full flex-col gap-4 sm:w-auto sm:flex-row">
            <a href="#inscricao" class="btn-primario btn-lg">
              Garantir inscrição
              <Seta />
            </a>
            <a href="#programacao" class="btn-secundario btn-lg">
              Ver programação
            </a>
          </div>
        </section>

        <div class="flex flex-wrap items-end justify-between gap-8 border-t border-line-100 pt-6">
          <ul class="flex flex-wrap gap-x-12 gap-y-4" aria-label="O evento em números">
            {evento.hero.numeros.map((n) => (
              <li class="flex flex-col">
                <span class="numeral-s text-ink-100">{n.valor}</span>
                <span class="dado text-ink-300">{n.rotulo}</span>
              </li>
            ))}
          </ul>
          <LogoConjunto altura={44} />
        </div>
      </div>
    </div>

    <div class="border-t border-line-100 lg:border-t-0">
      <FormInscricao />
    </div>
  </div>

  <!-- SOBRE -->
  <section id="sobre" aria-labelledby="sobre-t" class={secao}>
    <Titulo rotulo="Sobre o evento" id="sobre-t">
      Pesquisa local, de portas abertas
    </Titulo>
    <div class="grid gap-10 lg:grid-cols-[1fr_1.2fr]">
      <p class="body-l text-ink-200">{evento.objetivo}</p>
      <ul class="grid gap-4 sm:grid-cols-3 lg:grid-cols-1 xl:grid-cols-3">
        {[
          ['Para quem', evento.publico],
          ['Formato', 'Manhãs com palestras e apresentações de trabalhos; tardes com o minicurso.'],
          ['Realização', evento.realizacao],
        ].map(([t, d]) => (
          <Painel as="li" rotulo={t}>
            <p class="body-s text-ink-200">{d}</p>
          </Painel>
        ))}
      </ul>
    </div>
  </section>

  <!-- PROGRAMAÇÃO -->
  <section id="programacao" aria-labelledby="prog-t" class={secao}>
    <Titulo rotulo="Programação" id="prog-t">
      Três dias de atividades
    </Titulo>
    <div class="grid gap-6">
      {dias.map((d, i) => (
        <Painel
          as="article"
          rotulo={`Dia ${String(i + 1).padStart(2, '0')}`}
          meta={`${d.semana.replace('/', '.')}.2026`}
          corpo="px-6 pb-2"
          aria-labelledby={`dia-${d.data}`}
        >
          <h3 id={`dia-${d.data}`} class="sr-only">
            {d.rotulo} — {d.semana}
          </h3>
          <ol class="-mt-px">
            {d.atividades.map((a) => (
              <ItemProgramacao atividade={a} />
            ))}
          </ol>
        </Painel>
      ))}
    </div>
    <p class="mt-6 body-s text-ink-300">
      Programação preliminar — nomes de palestrantes e horários finais serão confirmados pela
      organização.
    </p>
  </section>

  <!-- MINICURSO -->
  <section id="minicurso" aria-labelledby="mini-t" class={secao}>
    <Titulo rotulo="Minicurso · 3 tardes" id="mini-t">
      {minicurso.titulo}
    </Titulo>
    <div class="grid gap-10 lg:grid-cols-[1fr_1.4fr]">
      <div class="flex flex-col items-start gap-6">
        <p class="body-l text-ink-200">{minicurso.resumo}</p>
        <Painel rotulo="Vagas" meta="Laboratório 1" class="w-full" cantos>
          <p class="h3 text-ink-100">
            {minicurso.vagas === null
              ? 'Limitadas pela capacidade do laboratório'
              : `${minicurso.vagas} vagas`}
          </p>
          <p class="body-s text-ink-200">
            Opcional: marque no formulário de inscrição. Quando as vagas acabam, a opção é bloqueada
            automaticamente.
          </p>
        </Painel>
        <a href="#inscricao" class="btn-secundario">
          Quero participar
          <Seta />
        </a>
      </div>
      <ol class="grid gap-4 sm:grid-cols-2">
        {minicurso.blocos.map((b) => (
          <Painel as="li" rotulo={`Aula ${Number(b.n)}`} meta="Google Colab">
            <h3 class="h3 text-ink-100">{b.titulo}</h3>
            <p class="body-s text-ink-200">{b.detalhe}</p>
          </Painel>
        ))}
      </ol>
    </div>
  </section>

  <!-- TRABALHOS -->
  <section id="trabalhos" aria-labelledby="trab-t" class={secao}>
    <Titulo rotulo="Chamada de trabalhos" id="trab-t">
      Apresente sua pesquisa
    </Titulo>
    <div class="grid gap-10 lg:grid-cols-2">
      <div class="flex flex-col items-start gap-8">
        <dl class="grid gap-6">
          {[
            ['Formato', trabalhos.formato],
            ['Como enviar', trabalhos.campos],
            ['Avaliação', trabalhos.avaliacao],
            ['Premiação', trabalhos.premiacao],
          ].map(([t, d]) => (
            <div>
              <dt class="rotulo text-lime-ink">{t}</dt>
              <dd class="mt-2 body-l text-ink-100">{d}</dd>
            </div>
          ))}
        </dl>
        <a href="#inscricao" class="btn-secundario">
          Inscrever e enviar trabalho
          <Seta />
        </a>
      </div>
      <Painel
        as="section"
        rotulo="Datas importantes"
        corpo="px-6 pb-2"
        aria-label="Datas importantes"
      >
        <ol class="-mt-px">
          {cronograma.map((c) => (
            <li class="grid grid-cols-[5.5rem_1fr] gap-4 border-t border-line-100 py-4 sm:grid-cols-[7rem_1fr]">
              <span class="dado text-lime-ink">{c.data}</span>
              <span class="text-ink-100">{c.item}</span>
            </li>
          ))}
        </ol>
        <p class="border-t border-line-100 py-4 body-s text-ink-300">
          Prazo das inscrições: {janela.textoProrrogacao}.
        </p>
      </Painel>
    </div>
  </section>

  <!-- PALESTRAS -->
  <section aria-labelledby="pal-t" class={secao}>
    <Titulo rotulo="Palestras" id="pal-t">
      Quem vai falar
    </Titulo>
    <div class="grid gap-6 md:grid-cols-2">
      {palestras.map((p) => (
        <Painel as="article" rotulo="Palestra" meta={p.quando}>
          <h3 class="h3 text-ink-100">{p.titulo}</h3>
          <p class="body-s text-ink-200">{p.quem}</p>
        </Painel>
      ))}
    </div>
  </section>

  <!-- LOCAL + REALIZAÇÃO -->
  <section id="local" aria-labelledby="local-t" class:list={[secao, 'grid gap-16 lg:grid-cols-2']}>
    <div class="flex flex-col items-start">
      <Titulo rotulo="Local" id="local-t">
        {evento.local.nome}
      </Titulo>
      <p class="body-l text-ink-100">{evento.local.detalhe}</p>
      <p class="mt-2 text-ink-200">{evento.local.endereco}</p>
      <a
        href={evento.local.mapa}
        class="btn-secundario mt-8"
        target="_blank"
        rel="noopener noreferrer"
      >
        Abrir no mapa<span class="sr-only"> (abre em nova aba)</span>
        <Seta />
      </a>
    </div>
    <div>
      <div class="mb-10 md:mb-12">
        <p class="rotulo text-lime-ink">Realização</p>
        <h2 class="mt-4 display-m text-ink-100">Quem organiza</h2>
      </div>
      <p class="body-l text-ink-200">{evento.realizacao}</p>
      <LogoConjunto altura={64} class="mt-8 h-auto max-w-full" />
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" aria-labelledby="faq-t" class="mx-auto max-w-4xl px-4 py-20 md:px-16 md:py-24">
    <Titulo rotulo="Dúvidas" id="faq-t">
      Perguntas frequentes
    </Titulo>
    <div class="border-b border-line-100">
      {faq.map((f) => (
        <details class="group border-t border-line-100">
          <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-4 py-5 text-[1.0625rem] leading-6 font-semibold text-ink-100 [&::-webkit-details-marker]:hidden">
            {f.p}
            <span
              class="grid size-8 shrink-0 place-items-center rounded-1 border border-line-200 font-mono text-lime-ink transition-transform group-open:rotate-45"
              aria-hidden="true"
            >
              +
            </span>
          </summary>
          <p class="pb-5 text-ink-200">{f.r}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="mx-auto max-w-7xl px-4 pb-24 md:px-16" aria-labelledby="cta-t">
    <div class="relative flex flex-col items-start gap-8 overflow-hidden rounded-2 border border-line-100 bg-bg-100 px-6 py-12 md:flex-row md:items-center md:justify-between md:px-14">
      <img
        src="/marca/textura-diagonal-264.svg"
        width="264"
        height="264"
        alt=""
        aria-hidden="true"
        class="pointer-events-none absolute -top-px -right-px hidden max-w-none select-none md:block"
        loading="lazy"
        decoding="async"
      />
      <h2 id="cta-t" class="relative display-l text-ink-100">
        Garanta sua vaga
        <br />
        no minicurso.
      </h2>
      <a href="#inscricao" class="btn-primario btn-lg relative">
        Fazer inscrição
        <Seta />
      </a>
    </div>
  </section>
</Base>
