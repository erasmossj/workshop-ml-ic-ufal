# Copie para supabase/functions/.env (NÃO versionado) para rodar as funções localmente.
# Em produção, defina os mesmos nomes com `supabase secrets set` — nunca no repositório.
# SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY são injetadas automaticamente pelo Supabase.

# Chave secreta de TESTE pública da Cloudflare (sempre aprova). Em produção, use a chave real.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Origens do site que podem chamar a função (CORS), separadas por vírgula.
ALLOWED_ORIGINS=http://localhost:4321,http://127.0.0.1:4321
# Sal do hash do IP no limite de requisições (o IP nunca é guardado puro).
RATE_LIMIT_SALT=sal-local-de-desenvolvimento
# Tentativas por origem a cada 10 minutos (produção: 10).
RATE_LIMIT_MAX=5
