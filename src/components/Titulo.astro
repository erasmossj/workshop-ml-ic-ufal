---
interface Props {
  rotulo: string;
  id?: string;
  centro?: boolean;
}
const { rotulo, id, centro = false } = Astro.props;
---

<div class:list={['mb-10 md:mb-14', centro && 'text-center']}>
  <p class="rotulo text-ciano">{rotulo}</p>
  <h2 id={id} class="mt-3 font-display text-4xl leading-[1.1] font-bold md:text-5xl">
    <slot />
  </h2>
</div>
