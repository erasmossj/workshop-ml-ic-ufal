---
/**
 * Rodapé. Regra da marca (Figma: Marca › Regras de uso): logo conjunto IEEE × CS × IC
 * obrigatório no rodapé, altura mínima 28 px, separado do IC-ML por space-6 (32 px).
 */
import { evento } from '../data/evento';
import Logo from './Logo.astro';
import LogoConjunto from './LogoConjunto.astro';
---

<footer class="no-print border-t border-line-100 bg-bg-100">
  <div class="mx-auto flex max-w-7xl flex-col gap-8 px-4 py-10 md:px-16">
    <div class="flex flex-wrap items-end justify-between gap-8">
      <Logo altura={32} />
      <LogoConjunto altura={44} />
    </div>
    <div class="flex flex-col gap-3 border-t border-line-100 pt-6 body-s text-ink-300 md:flex-row md:items-center md:justify-between">
      <p>
        © 2026 {evento.sigla} · {evento.realizacao}
      </p>
      <p class="flex flex-wrap gap-x-5 gap-y-2">
        <a
          href="/privacidade"
          class="inline-flex min-h-6 items-center text-ink-200 underline underline-offset-4 hover:text-lime-ink"
        >
          Política de privacidade
        </a>
        <span>{evento.contato ?? 'Contato: a definir'}</span>
      </p>
    </div>
  </div>
</footer>
