---
import Base from '../layouts/Base.astro';

// Validação pública de certificado pelo código (WML-60 · ADR-005). Mostra nome, carga horária,
// data de emissão e CPF mascarado. O link do e-mail e do PDF já traz ?codigo=...
const configurado = Boolean(import.meta.env.PUBLIC_SUPABASE_URL);
---

<Base
  title="Validar certificado"
  description="Confira se um certificado do IC-ML 2026 é autêntico pelo código de validação."
>
  <section class="mx-auto max-w-2xl px-4 py-10 md:px-10">
    <p class="rotulo text-lime-ink">Certificados</p>
    <h1 class="mt-4 display-m">Validar certificado</h1>
    <p class="mt-3 text-ink-200">
      Digite o código impresso no rodapé do certificado para conferir se ele foi emitido pelo
      evento.
    </p>

    {!configurado && (
      <p class="painel mt-6 p-6">
        A validação funciona só com o backend configurado (PUBLIC_SUPABASE_URL). Nesta versão de
        protótipo não há certificados para conferir.
      </p>
    )}

    <form id="form-validar" method="get" class="painel mt-6 p-6" novalidate>
      <label for="codigo" class="rotulo-campo">
        Código de validação
      </label>
      <div class="terminal">
        <input
          id="codigo"
          name="codigo"
          type="text"
          inputmode="text"
          autocomplete="off"
          autocapitalize="characters"
          spellcheck="false"
          placeholder="XXXXX-XXXXX-XXXXX-XXXXX"
          aria-describedby="codigo-ajuda codigo-erro"
          class="campo w-full font-mono uppercase"
        />
      </div>
      <p id="codigo-ajuda" class="mt-1 text-sm text-ink-200">
        20 letras e números, com ou sem hífens.
      </p>
      <p id="codigo-erro" class="erro-campo" aria-live="polite"></p>
      <button type="submit" class="btn-primario mt-4">
        Validar
      </button>
    </form>

    <div id="resultado" class="mt-6" aria-live="polite"></div>
  </section>
</Base>

<script>
  import { createClient } from '@supabase/supabase-js';
  import { formatarCargaHoraria, formatarEmissao, normalizarCodigo } from '../lib/certificado';

  const URL_SUPABASE: string | undefined = import.meta.env.PUBLIC_SUPABASE_URL;
  const CHAVE: string | undefined = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
  const form = document.getElementById('form-validar') as HTMLFormElement;
  const campo = document.getElementById('codigo') as HTMLInputElement;
  const erro = document.getElementById('codigo-erro')!;
  const resultado = document.getElementById('resultado')!;

  type Validacao = { nome: string; cpf_mascarado: string; minutos: number; emitido_em: string };

  function caixa(tom: 'ok' | 'erro', titulo: string, linhas: [string, string][] = []) {
    const div = document.createElement('div');
    div.className = `painel border-l-8 p-6 ${tom === 'ok' ? 'border-lime-ink' : 'border-danger'}`;
    const h = document.createElement('h2');
    h.className = `h2 ${tom === 'ok' ? 'text-lime-ink' : 'text-danger'}`;
    h.textContent = `${tom === 'ok' ? '✓' : '✕'} ${titulo}`;
    div.append(h);
    if (linhas.length) {
      const dl = document.createElement('dl');
      dl.className = 'mt-3 grid gap-2 sm:grid-cols-[auto_1fr] sm:gap-x-6';
      for (const [rotulo, valor] of linhas) {
        const dt = document.createElement('dt');
        dt.className = 'text-sm text-ink-200';
        dt.textContent = rotulo;
        const dd = document.createElement('dd');
        dd.className = 'font-medium';
        dd.textContent = valor;
        dl.append(dt, dd);
      }
      div.append(dl);
    }
    resultado.replaceChildren(div);
  }

  async function validar(texto: string) {
    const codigo = normalizarCodigo(texto);
    campo.setAttribute('aria-invalid', codigo ? 'false' : 'true');
    erro.textContent = codigo ? '' : 'O código tem 20 letras e números. Confira e tente de novo.';
    resultado.replaceChildren();
    if (!codigo || !URL_SUPABASE || !CHAVE) return;
    campo.value = codigo;
    const sb = createClient(URL_SUPABASE, CHAVE, { auth: { persistSession: false } });
    const { data, error } = await sb.rpc('validar_certificado', { p_codigo: codigo });
    if (error) {
      caixa('erro', 'Não foi possível consultar agora', [
        ['O que fazer', 'Tente de novo em instantes.'],
      ]);
      return;
    }
    const v = (data as Validacao[])[0];
    if (!v) {
      caixa('erro', 'Nenhum certificado com este código', [
        [
          'O que significa',
          'O código está errado ou o certificado não foi emitido pelo IC-ML 2026.',
        ],
      ]);
      return;
    }
    caixa('ok', 'Certificado válido', [
      ['Participante', v.nome],
      ['CPF', v.cpf_mascarado],
      ['Carga horária', formatarCargaHoraria(v.minutos)],
      ['Emitido em', formatarEmissao(v.emitido_em)],
      ['Código', codigo],
    ]);
  }

  form.addEventListener('submit', (ev) => {
    ev.preventDefault();
    const codigo = normalizarCodigo(campo.value) ?? campo.value.trim();
    history.replaceState(null, '', `?codigo=${encodeURIComponent(codigo)}`);
    void validar(campo.value);
  });

  const inicial = new URLSearchParams(location.search).get('codigo');
  if (inicial) {
    campo.value = inicial;
    void validar(inicial);
  }
</script>
