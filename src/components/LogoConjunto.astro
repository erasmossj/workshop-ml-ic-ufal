---
/**
 * Logo conjunto oficial Instituto de Computação · IEEE Computer Society Northeast Brazil Chapter ·
 * UFAL IEEE Student Branch · IEEE (Figma: Marca › Logo conjunto). Obrigatório em toda aplicação.
 * Branco sobre fundos escuros/navy, preto sobre claros. Altura mínima 28 px / 8 mm.
 * Nunca recolorir, desmontar ou aplicar sobre textura.
 */
interface Props {
  tom?: 'branco' | 'preto';
  /** Altura em px — no mínimo 28. */
  altura?: number;
  class?: string;
  /** 'eager' em impressos (crachá): imagem adiada pode não estar pronta ao imprimir. */
  carregamento?: 'lazy' | 'eager';
}

const { tom = 'branco', altura = 44, class: classe, carregamento = 'lazy' } = Astro.props;
const h = Math.max(altura, 28);
const w = Math.round((882 / 115) * h * 1000) / 1000;
---

<img
  src={`/marca/logo-conjunto-${tom}.svg`}
  width={w}
  height={h}
  alt="Instituto de Computação da UFAL, IEEE Computer Society — Capítulo Nordeste do Brasil, Ramo Estudantil IEEE da UFAL e IEEE"
  class:list={['h-auto max-w-full', classe]}
  decoding="async"
  loading={carregamento}
/>
