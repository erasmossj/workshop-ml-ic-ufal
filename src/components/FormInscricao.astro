---
/**
 * Formulário de inscrição (Figma: Hero — site oficial › Coluna de inscrição).
 * Usado na coluna do hero (home) e em /inscricao. Faixa halftone de corte seco no topo,
 * cabeçalho de sistema, campos estilo terminal, Checkbox e Choice.
 */
import { evento, janela, minicurso, trabalhos } from '../data/evento';
import { CURSO_MAX, RESUMO_MAX, VINCULO_OUTRO_MAX, VINCULOS } from '../lib/validacao';

interface Props {
  /** h1 em /inscricao; h2 na home. */
  nivel?: 'h1' | 'h2';
}

const { nivel = 'h2' } = Astro.props;
const Titulo = nivel;
// Com PUBLIC_SUPABASE_URL a inscrição é real (Edge Function `register`); sem, é demonstração.
const modoReal = Boolean(import.meta.env.PUBLIC_SUPABASE_URL);
const turnstileSiteKey: string | undefined = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
const opcional = 'text-ink-300';
---

<section id="inscricao" aria-labelledby="form-t" class="flex flex-col bg-bg-000">
  <div class="relative h-32 shrink-0 overflow-hidden border-b border-line-100" aria-hidden="true">
    <img
      src="/marca/textura-ribbon-420x132.svg"
      width="420"
      height="132"
      alt=""
      class="absolute top-0 left-0 h-33 w-105 max-w-none select-none"
      decoding="async"
    />
  </div>

  <div class="flex flex-col gap-3.5 px-4 pt-6 pb-8 sm:px-8">
    <div class="flex items-center justify-between gap-4 border-b border-line-100 pb-3.5">
      <p class="rotulo flex items-center gap-2 text-ink-100">
        <span class="led" aria-hidden="true"></span>
        Credenciamento
      </p>
      <p class="rotulo text-ink-300">
        <span aria-hidden="true">{janela.textoCurto}</span>
        <span class="sr-only">Inscrições de 30 de outubro a 16 de novembro</span>
      </p>
    </div>

    <div class="flex flex-col gap-0.5">
      <Titulo id="form-t" class="h2 text-ink-100">
        Inscrição rápida
      </Titulo>
      <p class="body-s text-ink-300">Gratuita e aberta à comunidade. Leva 1 minuto.</p>
    </div>

    <div
      id="resumo-erros"
      class="hidden rounded-1 border border-danger bg-bg-300 p-4 body-s"
      role="alert"
      tabindex="-1"
    >
      <p class="font-semibold text-danger">Confira os campos abaixo:</p>
      <ul class="mt-2 list-disc pl-5 text-ink-100"></ul>
    </div>

    <!-- method="post": se a pessoa enviar antes do script carregar, os dados vão no corpo, nunca
         na URL (histórico, logs da Vercel). O script intercepta o envio normal. -->
    <form
      id="form-inscricao"
      method="post"
      enctype="multipart/form-data"
      class="flex flex-col gap-3.5"
      novalidate
    >
      <div>
        <label for="nome" class="rotulo-campo">
          <span>Nome completo</span>
          <span class="obrigatorio">obrigatório</span>
        </label>
        <div class="terminal">
          <input
            id="nome"
            name="nome"
            class="campo"
            autocomplete="name"
            placeholder="como sai no certificado"
            required
            aria-describedby="nome-erro"
          />
        </div>
        <p id="nome-erro" class="erro-campo" aria-live="polite"></p>
      </div>

      <div>
        <label for="email" class="rotulo-campo">
          <span>E-mail</span>
          <span class="obrigatorio">obrigatório</span>
        </label>
        <div class="terminal">
          <input
            id="email"
            name="email"
            type="email"
            class="campo"
            autocomplete="email"
            placeholder="voce@ic.ufal.br"
            required
            aria-describedby="email-dica email-erro"
          />
        </div>
        <p id="email-dica" class="ajuda">
          Comprovante e certificado chegam aqui.
        </p>
        <p id="email-erro" class="erro-campo" aria-live="polite"></p>
      </div>

      <div>
        <label for="cpf" class="rotulo-campo">
          <span>CPF</span>
          <span class="obrigatorio">obrigatório</span>
        </label>
        <div class="terminal">
          <input
            id="cpf"
            name="cpf"
            class="campo"
            inputmode="numeric"
            autocomplete="off"
            placeholder="000.000.000-00"
            maxlength="14"
            required
            aria-describedby="cpf-dica cpf-erro"
          />
        </div>
        <p id="cpf-dica" class="ajuda">
          Só para o certificado. Na organização aparece mascarado.
        </p>
        <p id="cpf-erro" class="erro-campo" aria-live="polite"></p>
      </div>

      <div>
        <label for="instituicao" class="rotulo-campo">
          <span>Instituição</span>
          <span class={opcional}>opcional</span>
        </label>
        <div class="terminal">
          <input
            id="instituicao"
            name="instituicao"
            class="campo"
            autocomplete="organization"
            placeholder="ex.: UFAL"
          />
        </div>
      </div>

      <div>
        <p id="vinculo-rotulo" class="rotulo-campo">
          <span>Vínculo</span>
          <span class="obrigatorio">obrigatório</span>
        </p>
        <!-- Choice (Figma): escolha única segmentada. Sem opção pré-marcada. -->
        <div
          id="vinculo"
          role="radiogroup"
          aria-labelledby="vinculo-rotulo"
          aria-describedby="vinculo-erro"
          tabindex="-1"
          class="escolha mt-1.5 aria-invalid:border-danger"
        >
          {VINCULOS.map((v) => (
            <label>
              <input
                type="radio"
                name="vinculo"
                value={v.valor}
                aria-controls={v.valor === 'outro' ? 'vinculo-outro-bloco' : undefined}
              />
              {v.rotulo}
            </label>
          ))}
        </div>
        <p id="vinculo-erro" class="erro-campo" aria-live="polite"></p>
      </div>

      <!-- Só com "Outro" (WML-72). `hidden` tira da tela, do leitor de tela e da ordem do teclado. -->
      <div id="vinculo-outro-bloco" hidden>
        <label for="vinculo_outro" class="rotulo-campo">
          <span>Qual vínculo?</span>
          <span class="obrigatorio">obrigatório</span>
        </label>
        <div class="terminal">
          <input
            id="vinculo_outro"
            name="vinculo_outro"
            class="campo"
            maxlength={VINCULO_OUTRO_MAX}
            autocomplete="off"
            placeholder="ex.: servidor técnico"
            aria-describedby="vinculo_outro-dica vinculo_outro-erro"
          />
        </div>
        <p id="vinculo_outro-dica" class="ajuda">
          Até {VINCULO_OUTRO_MAX} caracteres. Aparece no seu crachá.
        </p>
        <p id="vinculo_outro-erro" class="erro-campo" aria-live="polite"></p>
      </div>

      <fieldset class="flex flex-col gap-3.5 border-t border-line-100 pt-3.5">
        <legend class="sr-only">Para o crachá</legend>
        <p class="rotulo text-ink-100" aria-hidden="true">
          Para o crachá
        </p>
        <div>
          <label for="curso" class="rotulo-campo">
            <span>Curso</span>
            <span class={opcional}>opcional</span>
          </label>
          <div class="terminal">
            <input
              id="curso"
              name="curso"
              class="campo"
              maxlength={CURSO_MAX}
              placeholder="ex.: Ciência da Computação"
            />
          </div>
        </div>
        <div>
          <label for="perfil" class="rotulo-campo">
            <span>LinkedIn ou Lattes</span>
            <span class="obrigatorio">obrigatório</span>
          </label>
          <div class="terminal">
            <input
              id="perfil"
              name="perfil"
              class="campo"
              inputmode="url"
              autocomplete="url"
              maxlength="200"
              placeholder="linkedin.com/in/seu-nome"
              required
              aria-required="true"
              aria-describedby="perfil-dica perfil-erro"
            />
          </div>
          <p id="perfil-dica" class="ajuda">
            Vira um QR Code no seu crachá. Aceita o link do seu perfil no LinkedIn
            (linkedin.com/in/…) ou no Lattes (lattes.cnpq.br/…).
          </p>
          <p id="perfil-erro" class="erro-campo" aria-live="polite"></p>
        </div>
      </fieldset>

      <div>
        <label for="minicurso" class="flex cursor-pointer items-center gap-3 font-medium body-s">
          <input
            id="minicurso"
            name="minicurso"
            type="checkbox"
            value="sim"
            class="caixa-selecao"
          />
          Quero o minicurso (Lab 1, vagas limitadas)
        </label>
        <p class="ajuda pl-7.5">
          {minicurso.vagas} vagas · 3 tardes. Quando as vagas acabam, a opção é bloqueada.
        </p>
      </div>

      <div>
        <label for="trabalho" class="flex cursor-pointer items-center gap-3 font-medium body-s">
          <input
            id="trabalho"
            name="trabalho"
            type="checkbox"
            value="sim"
            class="caixa-selecao"
            aria-controls="campos-trabalho"
            aria-expanded="false"
          />
          Vou submeter trabalho
        </label>
      </div>

      <div
        id="campos-trabalho"
        class="flex flex-col gap-3.5 border-l-2 border-line-100 pl-4"
        hidden
      >
        <p class="ajuda mt-0">
          {trabalhos.formato} Submissões de 30/10 a 16/11 ({janela.textoProrrogacao}).{' '}
          {trabalhos.vagasTexto}
        </p>
        <div>
          <label for="titulo" class="rotulo-campo">
            <span>Título do trabalho</span>
            <span class="obrigatorio">obrigatório</span>
          </label>
          <div class="terminal">
            <input
              id="titulo"
              name="titulo"
              class="campo"
              maxlength="250"
              aria-describedby="titulo-erro"
            />
          </div>
          <p id="titulo-erro" class="erro-campo" aria-live="polite"></p>
        </div>
        <div>
          <label for="autores" class="rotulo-campo">
            <span>Autores</span>
            <span class="obrigatorio">obrigatório</span>
          </label>
          <div class="terminal">
            <input
              id="autores"
              name="autores"
              class="campo"
              placeholder="Nome 1, Nome 2…"
              aria-describedby="autores-erro"
            />
          </div>
          <p id="autores-erro" class="erro-campo" aria-live="polite"></p>
        </div>
        <div>
          <label for="resumo" class="rotulo-campo">
            <span>Resumo</span>
            <span class="obrigatorio">obrigatório</span>
          </label>
          <div class="terminal">
            <textarea
              id="resumo"
              name="resumo"
              class="campo min-h-36"
              maxlength={RESUMO_MAX}
              aria-describedby="resumo-contador resumo-erro"
            ></textarea>
          </div>
          <p id="resumo-contador" class="ajuda">
            0 / {RESUMO_MAX} caracteres
          </p>
          <p id="resumo-erro" class="erro-campo" aria-live="polite"></p>
        </div>
        <!-- Acervo (WML-73 · ADR-007): consentimento separado, opcional e desmarcado. -->
        <div>
          <label for="acervo" class="flex cursor-pointer items-start gap-3 font-medium body-s">
            <input
              id="acervo"
              name="acervo"
              type="checkbox"
              value="sim"
              class="caixa-selecao mt-0.5 shrink-0"
              aria-describedby="acervo-dica"
            />
            <span>
              Autorizo manter meu trabalho (título, autores e resumo) no acervo de edições passadas
              do IC-ML, se ele for aprovado. Posso pedir a retirada a qualquer momento pelo e-mail
              do evento.
            </span>
          </label>
          <p id="acervo-dica" class="ajuda pl-7.5">
            Opcional. Sem esta autorização, o trabalho não entra no acervo. O acervo não guarda CPF
            nem e-mail. Retirada: {evento.contato}.
          </p>
        </div>
      </div>

      <div class="border-t border-line-100 pt-3.5">
        <label for="consentimento" class="flex cursor-pointer items-start gap-3 body-s">
          <input
            id="consentimento"
            name="consentimento"
            type="checkbox"
            value="sim"
            class="caixa-selecao mt-0.5"
            aria-describedby="consentimento-erro"
          />
          <span class="text-ink-200">
            Li e concordo com a{' '}
            <a
              href="/privacidade"
              class="font-semibold text-ink-100 underline underline-offset-4 hover:text-lime-ink"
            >
              Política de Privacidade
            </a>
            . Nome, CPF e e-mail serão usados para a inscrição e a emissão do certificado; vínculo,
            curso, instituição e perfil, para o crachá — conforme a LGPD. O trabalho só entra no
            acervo de edições passadas com a autorização separada.
          </span>
        </label>
        <p id="consentimento-erro" class="erro-campo" aria-live="polite"></p>
      </div>

      {turnstileSiteKey ? (
        <div
          class="cf-turnstile"
          data-sitekey={turnstileSiteKey}
          data-theme="dark"
          data-language="pt-br"
        />
      ) : (
        <div class="ajuda mt-0 flex items-center gap-3 rounded-1 border border-dashed border-line-200 p-4">
          <span class="size-4.5 shrink-0 rounded-1 border border-line-200" aria-hidden="true" />
          Verificação anti-robô (Cloudflare Turnstile) — ativa quando o backend está configurado.
        </div>
      )}

      <button type="submit" class="btn-primario btn-lg w-full">
        Confirmar inscrição
      </button>
      {!modoReal && (
        <p class="ajuda mt-0 text-center">
          *Número ilustrativo. Demonstração: use{' '}
          <code class="font-mono text-ink-200">ja@inscrito.com</code> para ver o aviso de e-mail
          repetido.
        </p>
      )}
    </form>
  </div>
  {turnstileSiteKey && (
    <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer />
  )}
</section>

<script>
  import { cpfValido, formatarCpf, mascararCpf } from '../lib/cpf';
  import { EMAIL_JA_INSCRITO, gerarNumero, salvarDemo } from '../lib/demo';
  import {
    RESUMO_MAX,
    emailValido,
    nomeCompletoValido,
    normalizarEmail,
    validarPerfil,
    validarVinculo,
  } from '../lib/validacao';

  const form = document.querySelector<HTMLFormElement>('#form-inscricao')!;
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const cpf = $<HTMLInputElement>('cpf');
  const trabalho = $<HTMLInputElement>('trabalho');
  const camposTrabalho = $<HTMLDivElement>('campos-trabalho');
  const resumo = $<HTMLTextAreaElement>('resumo');
  const resumoErros = $<HTMLDivElement>('resumo-erros');

  cpf.addEventListener('input', () => {
    cpf.value = formatarCpf(cpf.value);
  });
  resumo.addEventListener('input', () => {
    $('resumo-contador').textContent = `${resumo.value.length} / ${RESUMO_MAX} caracteres`;
  });
  // Vínculo "Outro" (WML-72): mostra "Qual vínculo?", obrigatório só enquanto visível.
  const vinculoOutroBloco = $<HTMLDivElement>('vinculo-outro-bloco');
  const vinculoOutro = $<HTMLInputElement>('vinculo_outro');
  const vinculoEscolhido = () =>
    form.querySelector<HTMLInputElement>('input[name=vinculo]:checked')?.value ?? '';
  $('vinculo').addEventListener('change', () => {
    const outro = vinculoEscolhido() === 'outro';
    vinculoOutroBloco.hidden = !outro;
    vinculoOutro.required = outro;
    if (!outro) {
      vinculoOutro.value = '';
      marcar('vinculo_outro', null);
    }
  });
  trabalho.addEventListener('change', () => {
    camposTrabalho.hidden = !trabalho.checked;
    trabalho.setAttribute('aria-expanded', String(trabalho.checked));
  });

  // Backend real (Edge Function) quando configurado; senão, demonstração local.
  const API: string | undefined = import.meta.env.PUBLIC_SUPABASE_URL;
  const CHAVE_PUBLICA: string | undefined = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
  const modoReal = Boolean(API && CHAVE_PUBLICA);

  type Erro = { id: string | null; msg: string };

  function marcar(id: string, msg: string | null) {
    document.getElementById(id)?.setAttribute('aria-invalid', msg ? 'true' : 'false');
    const destino = document.getElementById(`${id}-erro`);
    if (destino) destino.textContent = msg ?? '';
  }

  function mostrarErros(erros: Erro[]) {
    const lista = resumoErros.querySelector('ul')!;
    lista.replaceChildren(
      ...erros.map(({ id, msg }) => {
        const li = document.createElement('li');
        if (id && document.getElementById(id)) {
          const a = document.createElement('a');
          a.href = `#${id}`;
          a.textContent = msg;
          // block + min-h-6: alvo de ≥ 24 px (WCAG 2.5.8) independente da fonte carregada.
          a.className = 'block min-h-6 underline underline-offset-4';
          li.append(a);
        } else {
          li.textContent = msg;
        }
        return li;
      }),
    );
    resumoErros.classList.toggle('hidden', erros.length === 0);
    if (erros.length) resumoErros.focus();
  }

  async function enviarAoServidor(): Promise<{ numero: string; qr?: string } | Erro> {
    try {
      const r = await fetch(`${API}/functions/v1/register`, {
        method: 'POST',
        headers: { apikey: CHAVE_PUBLICA! },
        body: new FormData(form),
      });
      const corpo = await r.json().catch(() => ({}));
      if (r.ok && typeof corpo.numero === 'string') {
        return { numero: corpo.numero, qr: typeof corpo.qr === 'string' ? corpo.qr : undefined };
      }
      return {
        id: typeof corpo.campo === 'string' ? corpo.campo : null,
        msg: typeof corpo.erro === 'string' ? corpo.erro : 'Erro inesperado. Tente novamente.',
      };
    } catch {
      return {
        id: null,
        msg: 'Sem conexão com o servidor. Verifique sua internet e tente de novo.',
      };
    }
  }

  function validar(): { id: string; msg: string }[] {
    const erros: { id: string; msg: string }[] = [];
    const checar = (id: string, msg: string | null) => {
      marcar(id, msg);
      if (msg) erros.push({ id, msg });
    };
    const v = (id: string) => $<HTMLInputElement>(id).value.trim();

    checar(
      'nome',
      nomeCompletoValido(v('nome')) ? null : 'Informe nome e sobrenome, só com letras.',
    );
    const email = normalizarEmail(v('email'));
    checar(
      'email',
      !emailValido(email)
        ? 'Informe um e-mail válido.'
        : !modoReal && email === EMAIL_JA_INSCRITO
          ? 'Este e-mail já tem inscrição. Se errou algum dado, fale com a organização.'
          : null,
    );
    checar('cpf', cpfValido(v('cpf')) ? null : 'CPF inválido. Confira os números.');
    const erroVinculo = validarVinculo(vinculoEscolhido(), vinculoOutro.value);
    checar('vinculo', erroVinculo?.campo === 'vinculo' ? erroVinculo.msg : null);
    checar('vinculo_outro', erroVinculo?.campo === 'vinculo_outro' ? erroVinculo.msg : null);
    checar('perfil', validarPerfil(v('perfil')));

    if (trabalho.checked) {
      checar('titulo', v('titulo') ? null : 'Informe o título do trabalho.');
      checar('autores', v('autores') ? null : 'Informe os autores.');
      checar('resumo', v('resumo') ? null : 'Escreva o resumo.');
    }

    checar(
      'consentimento',
      $<HTMLInputElement>('consentimento').checked
        ? null
        : 'É preciso concordar para se inscrever.',
    );
    return erros;
  }

  form.addEventListener('submit', async (ev) => {
    ev.preventDefault();
    const erros = validar();
    mostrarErros(erros);
    if (erros.length) return;

    const botao = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    const rotuloOriginal = botao.textContent;
    botao.disabled = true;
    botao.textContent = 'Enviando…';

    let numero = gerarNumero();
    let qr: string | undefined;
    if (modoReal) {
      const resultado = await enviarAoServidor();
      if (!('numero' in resultado)) {
        if (resultado.id) marcar(resultado.id, resultado.msg);
        mostrarErros([resultado]);
        (window as { turnstile?: { reset: () => void } }).turnstile?.reset();
        botao.disabled = false;
        botao.textContent = rotuloOriginal;
        return;
      }
      numero = resultado.numero;
      qr = resultado.qr;
    }

    const v = (id: string) => $<HTMLInputElement>(id).value.trim();
    salvarDemo({
      numero,
      qr,
      nome: v('nome'),
      cpfMascarado: mascararCpf(v('cpf')),
      email: normalizarEmail(v('email')),
      minicurso: $<HTMLInputElement>('minicurso').checked,
      trabalho: trabalho.checked ? { titulo: v('titulo') } : null,
    });
    setTimeout(() => location.assign('/confirmacao'), modoReal ? 0 : 600);
  });
</script>
