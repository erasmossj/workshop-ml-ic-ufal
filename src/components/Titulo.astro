---
/** Título de seção: rótulo mono em lime-ink + Display/display-m (Pixelify Sans). */
interface Props {
  rotulo: string;
  id?: string;
  centro?: boolean;
}
const { rotulo, id, centro = false } = Astro.props;
---

<div class:list={['mb-10 md:mb-12', centro && 'text-center']}>
  <p class="rotulo text-lime-ink">{rotulo}</p>
  <h2 id={id} class="mt-4 display-m text-ink-100">
    <slot />
  </h2>
</div>
