---
/**
 * Nav do Figma (Hero — site oficial › Nav): logo IC-ML à esquerda, links mono em caixa alta.
 * `embutido`: dentro do bloco esquerdo do hero (home). Padrão: barra no topo das demais páginas.
 */
import Logo from './Logo.astro';

interface Props {
  embutido?: boolean;
}

const { embutido = false } = Astro.props;
const links = [
  { href: '/#programacao', label: 'Programação' },
  { href: '/#minicurso', label: 'Minicurso' },
  { href: '/#trabalhos', label: 'Submissões' },
  { href: '/#local', label: 'Local' },
];
const link = 'rotulo inline-flex min-h-6 items-center text-ink-200 transition hover:text-lime-ink';
---

<header
  class:list={['no-print', !embutido && 'sticky top-0 z-40 border-b border-line-100 bg-bg-100']}
>
  <div
    class:list={[
      'flex items-center justify-between gap-6',
      !embutido && 'mx-auto max-w-7xl px-4 py-4 md:px-16',
    ]}
  >
    <!-- O alt começa por "IC-ML 2026", o texto do logo (WCAG 2.5.3, comando de voz). -->
    <a href="/" class="inline-flex shrink-0">
      <Logo altura={32} alt="IC-ML 2026 (página inicial)" />
    </a>

    <nav aria-label="Principal" class="hidden items-center gap-6 md:flex">
      {links.map((l) => (
        <a href={l.href} class={link}>
          {l.label}
        </a>
      ))}
    </nav>

    <details class="relative md:hidden">
      <summary class="rotulo flex min-h-11 cursor-pointer list-none items-center gap-2 rounded-1 border border-line-200 px-4 text-ink-100 [&::-webkit-details-marker]:hidden">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M2 4h12M2 8h12M2 12h12" stroke="currentColor" stroke-width="1.5"></path>
        </svg>
        Menu
      </summary>
      <nav
        aria-label="Principal (celular)"
        class="absolute right-0 z-50 mt-2 flex w-60 flex-col rounded-2 border border-line-100 bg-bg-200 p-2"
      >
        {links.map((l) => (
          <a href={l.href} class:list={[link, 'min-h-11 rounded-1 px-3 hover:bg-bg-300']}>
            {l.label}
          </a>
        ))}
        <a href="/inscricao" class="btn-primario mt-2">
          Garantir inscrição
        </a>
      </nav>
    </details>
  </div>
</header>
