---
import { janela, minicurso, trabalhos } from '../data/evento';
import Base from '../layouts/Base.astro';
import { RESUMO_MAX } from '../lib/validacao';

const legenda = 'float-left mb-5 w-full font-display text-2xl font-bold';
// Com PUBLIC_SUPABASE_URL a inscrição é real (Edge Function `register`); sem, é demonstração.
const modoReal = Boolean(import.meta.env.PUBLIC_SUPABASE_URL);
const turnstileSiteKey: string | undefined = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<Base title="Inscrição" description="Inscreva-se no IC-ML 2026, no minicurso e envie seu trabalho.">
  <div class="mx-auto max-w-3xl px-5 py-12 md:px-10 md:py-16">
    <p class="rotulo inline-block rounded-full bg-ciano/15 px-4 py-2 text-ciano">
      Inscrição · IC-ML 2026
    </p>
    <h1 class="mt-5 font-display text-4xl leading-tight font-extrabold md:text-6xl">
      Faça sua inscrição
    </h1>
    <p class="mt-5 text-lg text-suave">
      A inscrição dá acesso a todas as palestras e apresentações dos 3 dias. Minicurso e envio de
      trabalho são opcionais. Campos com <span aria-hidden="true">*</span>
      <span class="sr-only">asterisco</span> são obrigatórios.
    </p>

    <div
      id="resumo-erros"
      class="mt-8 hidden rounded-2xl border border-erro bg-erro/10 p-5"
      role="alert"
      tabindex="-1"
    >
      <p class="font-bold text-erro">Confira os campos abaixo:</p>
      <ul class="mt-2 list-disc pl-5"></ul>
    </div>

    <form id="form-inscricao" class="mt-8 flex flex-col gap-6" novalidate>
      <!-- 1. Dados -->
      <fieldset class="vidro p-6 md:p-8">
        <legend class={legenda}>1 · Dados para o certificado</legend>
        <div class="clear-both grid gap-5">
          <div>
            <label for="nome" class="font-semibold">
              Nome completo *
            </label>
            <input
              id="nome"
              name="nome"
              class="campo mt-1.5"
              autocomplete="name"
              required
              aria-describedby="nome-dica nome-erro"
            />
            <p id="nome-dica" class="mt-1 text-sm text-suave">
              Exatamente como deve sair no certificado.
            </p>
            <p id="nome-erro" class="erro-campo" aria-live="polite"></p>
          </div>
          <div class="grid gap-5 md:grid-cols-2">
            <div>
              <label for="cpf" class="font-semibold">
                CPF *
              </label>
              <input
                id="cpf"
                name="cpf"
                class="campo mt-1.5"
                inputmode="numeric"
                autocomplete="off"
                placeholder="000.000.000-00"
                maxlength="14"
                required
                aria-describedby="cpf-dica cpf-erro"
              />
              <p id="cpf-dica" class="mt-1 text-sm text-suave">
                Usado só no certificado. Na planilha da organização aparece mascarado.
              </p>
              <p id="cpf-erro" class="erro-campo" aria-live="polite"></p>
            </div>
            <div>
              <label for="email" class="font-semibold">
                E-mail *
              </label>
              <input
                id="email"
                name="email"
                type="email"
                class="campo mt-1.5"
                autocomplete="email"
                placeholder="voce@exemplo.com"
                required
                aria-describedby="email-dica email-erro"
              />
              <p id="email-dica" class="mt-1 text-sm text-suave">
                Comprovante e certificado chegam aqui. Um e-mail por inscrição.
              </p>
              <p id="email-erro" class="erro-campo" aria-live="polite"></p>
            </div>
          </div>
          <div>
            <label for="instituicao" class="font-semibold">
              Instituição <span class="font-normal text-suave">(opcional)</span>
            </label>
            <input
              id="instituicao"
              name="instituicao"
              class="campo mt-1.5"
              autocomplete="organization"
              placeholder="Ex.: UFAL — Instituto de Computação"
            />
          </div>
        </div>
      </fieldset>

      <!-- 2. Minicurso -->
      <fieldset class="vidro p-6 md:p-8">
        <legend class={legenda}>2 · Minicurso (opcional)</legend>
        <label class="clear-both flex cursor-pointer items-start gap-4 rounded-2xl border border-white/25 bg-white/[0.04] p-4 transition has-checked:border-acao-1 has-checked:bg-acao-1/10">
          <input
            id="minicurso"
            name="minicurso"
            type="checkbox"
            value="sim"
            class="mt-1 size-5 shrink-0 accent-acao-1"
          />
          <span class="flex-1">
            <span class="block font-semibold">{minicurso.titulo}</span>
            <span class="block text-sm text-suave">
              3 tardes (02, 03 e 04/12) no Laboratório 1 · Google Colab
            </span>
          </span>
          <span class="rotulo shrink-0 text-ciano">{minicurso.vagasRestantesDemo} vagas*</span>
        </label>
        <p class="mt-2 text-sm text-suave">
          *Número ilustrativo. Quando as vagas acabarem, esta opção fica bloqueada.
        </p>
      </fieldset>

      <!-- 3. Trabalho -->
      <fieldset class="vidro p-6 md:p-8">
        <legend class={legenda}>3 · Trabalho (opcional)</legend>
        <label class="clear-both flex cursor-pointer items-center gap-3 font-semibold">
          <input
            id="trabalho"
            name="trabalho"
            type="checkbox"
            value="sim"
            class="size-5 accent-acao-1"
            aria-controls="campos-trabalho"
            aria-expanded="false"
          />
          Quero submeter um trabalho
        </label>
        <div id="campos-trabalho" class="mt-5 grid gap-5" hidden>
          <p class="text-sm text-suave">
            {trabalhos.formato} Submissões de 30/10 a 16/11 ({janela.textoProrrogacao}).
          </p>
          <div>
            <label for="titulo" class="font-semibold">
              Título do trabalho *
            </label>
            <input
              id="titulo"
              name="titulo"
              class="campo mt-1.5"
              maxlength="250"
              aria-describedby="titulo-erro"
            />
            <p id="titulo-erro" class="erro-campo" aria-live="polite"></p>
          </div>
          <div>
            <label for="autores" class="font-semibold">
              Autores *
            </label>
            <input
              id="autores"
              name="autores"
              class="campo mt-1.5"
              placeholder="Nome 1, Nome 2…"
              aria-describedby="autores-erro"
            />
            <p id="autores-erro" class="erro-campo" aria-live="polite"></p>
          </div>
          <div>
            <label for="resumo" class="font-semibold">
              Resumo *
            </label>
            <textarea
              id="resumo"
              name="resumo"
              class="campo mt-1.5 min-h-36"
              maxlength={RESUMO_MAX}
              aria-describedby="resumo-contador resumo-erro"
            ></textarea>
            <p id="resumo-contador" class="mt-1 text-sm text-suave">
              0 / {RESUMO_MAX} caracteres
            </p>
            <p id="resumo-erro" class="erro-campo" aria-live="polite"></p>
          </div>
          <div>
            <label for="pdf" class="font-semibold">
              Arquivo PDF *
            </label>
            <input
              id="pdf"
              name="pdf"
              type="file"
              accept="application/pdf,.pdf"
              class="campo mt-1.5 file:mr-4 file:rounded-full file:border-0 file:bg-white/15 file:px-4 file:py-2 file:text-sm file:font-semibold file:text-texto"
              aria-describedby="pdf-dica pdf-erro"
            />
            <p id="pdf-dica" class="mt-1 text-sm text-suave">
              Somente PDF, até 5 MB.
            </p>
            <p id="pdf-erro" class="erro-campo" aria-live="polite"></p>
          </div>
          <div class="rounded-2xl border border-dashed border-white/30 p-4">
            <label for="premio" class="flex cursor-pointer items-center gap-3 font-semibold">
              <input
                id="premio"
                name="premio"
                type="checkbox"
                value="sim"
                class="size-5 accent-acao-1"
                aria-describedby="premio-dica"
              />
              Quero concorrer à premiação
            </label>
            <p id="premio-dica" class="mt-1 ml-8 text-sm text-suave">
              Melhor trabalho de graduação e de mestrado.
            </p>
            <div class="mt-4">
              <label for="nivel" class="font-semibold">
                Categoria
              </label>
              <select id="nivel" name="nivel" class="campo mt-1.5" aria-describedby="nivel-erro">
                <option value="">Selecione…</option>
                <option value="graduacao">Graduação</option>
                <option value="mestrado">Mestrado</option>
              </select>
              <p id="nivel-erro" class="erro-campo" aria-live="polite"></p>
            </div>
          </div>
        </div>
      </fieldset>

      <!-- 4. Confirmação -->
      <fieldset class="vidro p-6 md:p-8">
        <legend class={legenda}>4 · Confirmar</legend>
        <label class="clear-both flex cursor-pointer items-start gap-3">
          <input
            id="consentimento"
            name="consentimento"
            type="checkbox"
            value="sim"
            class="mt-1 size-5 shrink-0 accent-acao-1"
            aria-describedby="consentimento-erro"
          />
          <span class="text-suave">
            Li e concordo com a{' '}
            <a href="/privacidade" class="font-semibold text-texto underline underline-offset-4">
              Política de Privacidade
            </a>
            . Nome, CPF e e-mail serão usados para a inscrição e a emissão do certificado, conforme
            a LGPD. *
          </span>
        </label>
        <p id="consentimento-erro" class="erro-campo" aria-live="polite"></p>
        {turnstileSiteKey ? (
          <div
            class="cf-turnstile mt-5"
            data-sitekey={turnstileSiteKey}
            data-theme="dark"
            data-language="pt-br"
          />
        ) : (
          <div class="mt-5 flex items-center gap-3 rounded-xl border border-dashed border-white/30 p-4 text-sm text-suave">
            <span class="size-5 rounded border-2 border-white/40" aria-hidden="true" />
            Verificação anti-robô (Cloudflare Turnstile) — ativa quando o backend está configurado.
          </div>
        )}
        <button type="submit" class="btn-primario mt-6 w-full">
          Confirmar inscrição
        </button>
        {!modoReal && (
          <p class="mt-3 text-center text-sm text-suave">
            Demonstração: use <code class="font-mono">ja@inscrito.com</code> para ver o aviso de
            e-mail repetido.
          </p>
        )}
      </fieldset>
    </form>
  </div>
  {turnstileSiteKey && (
    <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer />
  )}
</Base>

<script>
  import { cpfValido, formatarCpf, mascararCpf } from '../lib/cpf';
  import { EMAIL_JA_INSCRITO, gerarNumero, salvarDemo } from '../lib/demo';
  import {
    RESUMO_MAX,
    emailValido,
    nomeCompletoValido,
    normalizarEmail,
    validarPdf,
  } from '../lib/validacao';

  const form = document.querySelector<HTMLFormElement>('#form-inscricao')!;
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const cpf = $<HTMLInputElement>('cpf');
  const trabalho = $<HTMLInputElement>('trabalho');
  const camposTrabalho = $<HTMLDivElement>('campos-trabalho');
  const resumo = $<HTMLTextAreaElement>('resumo');
  const resumoErros = $<HTMLDivElement>('resumo-erros');

  cpf.addEventListener('input', () => {
    cpf.value = formatarCpf(cpf.value);
  });
  resumo.addEventListener('input', () => {
    $('resumo-contador').textContent = `${resumo.value.length} / ${RESUMO_MAX} caracteres`;
  });
  trabalho.addEventListener('change', () => {
    camposTrabalho.hidden = !trabalho.checked;
    trabalho.setAttribute('aria-expanded', String(trabalho.checked));
  });

  // Backend real (Edge Function) quando configurado; senão, demonstração local.
  const API: string | undefined = import.meta.env.PUBLIC_SUPABASE_URL;
  const CHAVE_PUBLICA: string | undefined = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
  const modoReal = Boolean(API && CHAVE_PUBLICA);

  type Erro = { id: string | null; msg: string };

  function marcar(id: string, msg: string | null) {
    document.getElementById(id)?.setAttribute('aria-invalid', msg ? 'true' : 'false');
    const destino = document.getElementById(`${id}-erro`);
    if (destino) destino.textContent = msg ?? '';
  }

  function mostrarErros(erros: Erro[]) {
    const lista = resumoErros.querySelector('ul')!;
    lista.replaceChildren(
      ...erros.map(({ id, msg }) => {
        const li = document.createElement('li');
        if (id && document.getElementById(id)) {
          const a = document.createElement('a');
          a.href = `#${id}`;
          a.textContent = msg;
          // inline-block + min-h-6: alvo de ≥ 24 px (WCAG 2.5.8) independente da fonte carregada.
          a.className = 'inline-block min-h-6 underline underline-offset-4';
          li.append(a);
        } else {
          li.textContent = msg;
        }
        return li;
      }),
    );
    resumoErros.classList.toggle('hidden', erros.length === 0);
    if (erros.length) resumoErros.focus();
  }

  async function enviarAoServidor(): Promise<{ numero: string } | Erro> {
    try {
      const r = await fetch(`${API}/functions/v1/register`, {
        method: 'POST',
        headers: { apikey: CHAVE_PUBLICA! },
        body: new FormData(form),
      });
      const corpo = await r.json().catch(() => ({}));
      if (r.ok && typeof corpo.numero === 'string') return { numero: corpo.numero };
      return {
        id: typeof corpo.campo === 'string' ? corpo.campo : null,
        msg: typeof corpo.erro === 'string' ? corpo.erro : 'Erro inesperado. Tente novamente.',
      };
    } catch {
      return {
        id: null,
        msg: 'Sem conexão com o servidor. Verifique sua internet e tente de novo.',
      };
    }
  }

  async function validar(): Promise<{ id: string; msg: string }[]> {
    const erros: { id: string; msg: string }[] = [];
    const checar = (id: string, msg: string | null) => {
      marcar(id, msg);
      if (msg) erros.push({ id, msg });
    };
    const v = (id: string) => $<HTMLInputElement>(id).value.trim();

    checar(
      'nome',
      nomeCompletoValido(v('nome')) ? null : 'Informe nome e sobrenome, só com letras.',
    );
    checar('cpf', cpfValido(v('cpf')) ? null : 'CPF inválido. Confira os números.');
    const email = normalizarEmail(v('email'));
    checar(
      'email',
      !emailValido(email)
        ? 'Informe um e-mail válido.'
        : !modoReal && email === EMAIL_JA_INSCRITO
          ? 'Este e-mail já tem inscrição. Se errou algum dado, fale com a organização.'
          : null,
    );

    if (trabalho.checked) {
      checar('titulo', v('titulo') ? null : 'Informe o título do trabalho.');
      checar('autores', v('autores') ? null : 'Informe os autores.');
      checar('resumo', v('resumo') ? null : 'Escreva o resumo.');
      const arquivo = $<HTMLInputElement>('pdf').files?.[0];
      if (!arquivo) checar('pdf', 'Anexe o PDF do trabalho.');
      else {
        const bytes = new Uint8Array(await arquivo.slice(0, 5).arrayBuffer());
        checar('pdf', validarPdf(arquivo, bytes));
      }
      const premio = $<HTMLInputElement>('premio').checked;
      checar('nivel', premio && !v('nivel') ? 'Escolha a categoria para concorrer.' : null);
    }

    checar(
      'consentimento',
      $<HTMLInputElement>('consentimento').checked
        ? null
        : 'É preciso concordar para se inscrever.',
    );
    return erros;
  }

  form.addEventListener('submit', async (ev) => {
    ev.preventDefault();
    const erros = await validar();
    mostrarErros(erros);
    if (erros.length) return;

    const botao = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    const rotuloOriginal = botao.textContent;
    botao.disabled = true;
    botao.textContent = 'Enviando…';

    let numero = gerarNumero();
    if (modoReal) {
      const resultado = await enviarAoServidor();
      if (!('numero' in resultado)) {
        if (resultado.id) marcar(resultado.id, resultado.msg);
        mostrarErros([resultado]);
        (window as { turnstile?: { reset: () => void } }).turnstile?.reset();
        botao.disabled = false;
        botao.textContent = rotuloOriginal;
        return;
      }
      numero = resultado.numero;
    }

    const v = (id: string) => $<HTMLInputElement>(id).value.trim();
    salvarDemo({
      numero,
      nome: v('nome'),
      cpfMascarado: mascararCpf(v('cpf')),
      email: normalizarEmail(v('email')),
      minicurso: $<HTMLInputElement>('minicurso').checked,
      trabalho: trabalho.checked
        ? { titulo: v('titulo'), premio: $<HTMLInputElement>('premio').checked, nivel: v('nivel') }
        : null,
    });
    setTimeout(() => location.assign('/confirmacao'), modoReal ? 0 : 600);
  });
</script>
