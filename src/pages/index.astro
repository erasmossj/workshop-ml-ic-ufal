---
import Titulo from '../components/Titulo.astro';
import { cronograma, dias, evento, faq, janela, minicurso, trabalhos } from '../data/evento';
import Base from '../layouts/Base.astro';

const icones = {
  cal: 'M7 3v3M17 3v3M4 9h16M5 5h14a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1z',
  pin: 'M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21zM12 12a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z',
  doc: 'M14 3H6a1 1 0 0 0-1 1v16a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V8l-5-5zM14 3v5h5',
  check: 'M5 12.5l4.5 4.5L19 7.5',
};

const chips = [
  { icone: icones.cal, rotulo: 'Quando', valor: '02 a 04/12/2026' },
  { icone: icones.pin, rotulo: 'Onde', valor: 'IC · UFAL, Maceió' },
  { icone: icones.doc, rotulo: 'Inscrições', valor: '30/10 a 16/11' },
];

const destaques = [
  ['3 dias', 'de palestras, trabalhos e minicurso'],
  ['Minicurso', '3 tardes no Google Colab'],
  ['Trabalhos', 'apresentação oral ou pôster'],
  ['Certificado', 'com carga horária'],
];

const palestras = [
  {
    quando: 'Qua · 02/12 · 10h',
    titulo: 'Palestra de abertura',
    quem: 'Pesquisador convidado — a confirmar',
  },
  {
    quando: 'Sex · 04/12 · 11h',
    titulo: 'ML e ciência de dados no mercado',
    quem: 'Convidado do setor — a confirmar',
  },
];

const realizacao = [
  'IEEE Ramo Estudantil UFAL',
  'IEEE Computer Society UFAL',
  'Instituto de Computação — UFAL',
];
---

<Base>
  <!-- HERO -->
  <section aria-labelledby="titulo-evento" class="relative overflow-hidden">
    <div
      class="pointer-events-none absolute -top-32 -left-24 size-96 rounded-full bg-ciano/20 blur-3xl"
      aria-hidden="true"
    ></div>
    <div
      class="pointer-events-none absolute -right-24 bottom-0 size-96 rounded-full bg-acao-2/25 blur-3xl"
      aria-hidden="true"
    ></div>
    <div class="relative mx-auto flex max-w-5xl flex-col items-center px-5 py-20 text-center md:py-28">
      <p class="rotulo rounded-full bg-ciano/15 px-4 py-2 text-ciano">
        {evento.sigla} · 02—04 dez 2026
      </p>
      <h1
        id="titulo-evento"
        class="mt-6 font-display text-5xl leading-[1.05] font-extrabold tracking-tight md:text-7xl"
      >
        Workshop de
        <br />
        Machine Learning
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-suave md:text-xl">{evento.resumo}</p>
      <div class="mt-8 flex w-full flex-col gap-3 sm:w-auto sm:flex-row">
        <a href="/inscricao" class="btn-primario">
          Inscreva-se
        </a>
        <a href="#programacao" class="btn-secundario">
          Ver programação
        </a>
      </div>
      <ul class="mt-12 grid w-full gap-4 sm:grid-cols-3">
        {chips.map((c) => (
          <li class="vidro flex items-center gap-4 p-5 text-left">
            <svg
              width="28"
              height="28"
              viewBox="0 0 24 24"
              fill="none"
              class="shrink-0 text-ciano"
              aria-hidden="true"
            >
              <path
                d={c.icone}
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
            <span>
              <span class="rotulo block text-suave">{c.rotulo}</span>
              <span class="mt-1 block font-display font-bold">{c.valor}</span>
            </span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- DESTAQUES -->
  <section aria-label="Destaques" class="mx-auto max-w-7xl px-5 md:px-10">
    <ul class="vidro grid grid-cols-2 gap-6 p-6 md:grid-cols-4 md:p-8">
      {destaques.map(([a, b]) => (
        <li>
          <p class="font-display text-2xl font-bold md:text-3xl">{a}</p>
          <p class="mt-1 text-sm text-suave">{b}</p>
        </li>
      ))}
    </ul>
  </section>

  <!-- SOBRE -->
  <section id="sobre" aria-labelledby="sobre-t" class="mx-auto max-w-7xl px-5 py-20 md:px-10">
    <Titulo rotulo="Sobre o evento" id="sobre-t">
      Pesquisa local, de portas abertas
    </Titulo>
    <div class="grid gap-10 md:grid-cols-2">
      <p class="text-lg leading-relaxed text-suave">{evento.objetivo}</p>
      <dl class="grid gap-4">
        {[
          ['Para quem', evento.publico],
          ['Formato', 'Manhãs com palestras e apresentações de trabalhos; tardes com o minicurso.'],
          ['Realização', evento.realizacao],
        ].map(([t, d]) => (
          <div class="vidro flex gap-4 p-5">
            <svg
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              class="mt-0.5 shrink-0 text-ciano"
              aria-hidden="true"
            >
              <path
                d={icones.check}
                stroke="currentColor"
                stroke-width="2.2"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
            <div>
              <dt class="font-semibold">{t}</dt>
              <dd class="text-suave">{d}</dd>
            </div>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- PROGRAMAÇÃO -->
  <section id="programacao" aria-labelledby="prog-t" class="mx-auto max-w-7xl px-5 py-20 md:px-10">
    <Titulo rotulo="Programação" id="prog-t">
      Três dias de atividades
    </Titulo>
    <div class="grid gap-6 md:grid-cols-3">
      {dias.map((d) => (
        <article class="vidro p-6" aria-labelledby={`dia-${d.data}`}>
          <p class="rotulo text-ciano">{d.rotulo}</p>
          <h3 id={`dia-${d.data}`} class="mt-2 font-display text-2xl font-bold">
            {d.semana}
          </h3>
          <ol class="mt-5 divide-y divide-white/10 border-t border-white/20">
            {d.atividades.map((a) => (
              <li class={`flex gap-4 py-2.5 ${a.tipo === 'pausa' ? 'text-suave' : ''}`}>
                <span class="w-24 shrink-0 font-mono text-sm text-ciano">
                  {a.inicio}–{a.fim}
                </span>
                <span class={a.tipo === 'minicurso' ? 'font-semibold' : ''}>{a.titulo}</span>
              </li>
            ))}
          </ol>
        </article>
      ))}
    </div>
    <p class="mt-6 text-sm text-suave">
      Programação preliminar — nomes de palestrantes e horários finais serão confirmados pela
      organização.
    </p>
  </section>

  <!-- MINICURSO -->
  <section id="minicurso" aria-labelledby="mini-t" class="mx-auto max-w-7xl px-5 py-20 md:px-10">
    <Titulo rotulo="Minicurso · 3 tardes" id="mini-t">
      {minicurso.titulo}
    </Titulo>
    <div class="grid gap-10 md:grid-cols-[1fr_1.4fr]">
      <div class="flex flex-col gap-6">
        <p class="text-lg leading-relaxed text-suave">{minicurso.resumo}</p>
        <div class="vidro p-5">
          <p class="rotulo text-ciano">Vagas</p>
          <p class="mt-1 font-semibold">
            {minicurso.vagas === null
              ? 'Limitadas pela capacidade do laboratório — número a definir.'
              : `${minicurso.vagas} vagas`}
          </p>
          <p class="mt-1 text-sm text-suave">
            Opcional: marque no formulário de inscrição. Quando as vagas acabam, a opção é bloqueada
            automaticamente.
          </p>
        </div>
        <a href="/inscricao" class="btn-primario self-start">
          Quero participar
        </a>
      </div>
      <ol class="grid gap-4 sm:grid-cols-2">
        {minicurso.blocos.map((b) => (
          <li class="vidro p-6">
            <span class="texto-acao font-display text-5xl font-extrabold">{b.n}</span>
            <h3 class="mt-3 text-xl font-bold">{b.titulo}</h3>
            <p class="mt-1 text-suave">{b.detalhe}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- TRABALHOS -->
  <section id="trabalhos" aria-labelledby="trab-t" class="mx-auto max-w-7xl px-5 py-20 md:px-10">
    <Titulo rotulo="Chamada de trabalhos" id="trab-t">
      Apresente sua pesquisa
    </Titulo>
    <div class="grid gap-10 md:grid-cols-2">
      <dl class="grid gap-6">
        {[
          ['Formato', trabalhos.formato],
          ['Como enviar', trabalhos.campos],
          ['Avaliação', trabalhos.avaliacao],
          ['Premiação', trabalhos.premiacao],
        ].map(([t, d]) => (
          <div>
            <dt class="rotulo text-ciano">{t}</dt>
            <dd class="mt-1 text-lg">{d}</dd>
          </div>
        ))}
        <a href="/inscricao" class="btn-primario self-start">
          Inscrever e enviar trabalho
        </a>
      </dl>
      <div class="vidro p-6">
        <h3 class="rotulo text-ciano">Datas importantes</h3>
        <ol class="mt-4 divide-y divide-white/10">
          {cronograma.map((c) => (
            <li class="flex gap-5 py-3">
              <span class="w-20 shrink-0 font-mono font-medium text-ciano">{c.data}</span>
              <span>{c.item}</span>
            </li>
          ))}
        </ol>
        <p class="mt-4 text-sm text-suave">Prazo das inscrições: {janela.textoProrrogacao}.</p>
      </div>
    </div>
  </section>

  <!-- PALESTRAS -->
  <section aria-labelledby="pal-t" class="mx-auto max-w-7xl px-5 py-20 md:px-10">
    <Titulo rotulo="Palestras" id="pal-t">
      Quem vai falar
    </Titulo>
    <div class="grid gap-6 md:grid-cols-2">
      {palestras.map((p) => (
        <article class="vidro flex items-center gap-5 p-6">
          <div
            class="size-20 shrink-0 rounded-full bg-linear-to-br from-ciano/40 to-acao-2/40"
            aria-hidden="true"
          />
          <div>
            <p class="rotulo text-ciano">{p.quando}</p>
            <h3 class="mt-2 font-display text-xl font-bold">{p.titulo}</h3>
            <p class="mt-1 text-suave">{p.quem}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- LOCAL + REALIZAÇÃO -->
  <section
    aria-labelledby="local-t"
    class="mx-auto grid max-w-7xl gap-12 px-5 py-20 md:grid-cols-2 md:px-10"
  >
    <div>
      <Titulo rotulo="Local" id="local-t">
        {evento.local.nome}
      </Titulo>
      <p class="text-lg">{evento.local.detalhe}</p>
      <p class="mt-2 text-suave">{evento.local.endereco}</p>
      <a
        href={evento.local.mapa}
        class="btn-secundario mt-6"
        target="_blank"
        rel="noopener noreferrer"
      >
        Abrir no mapa<span class="sr-only"> (abre em nova aba)</span>
      </a>
    </div>
    <div>
      <div class="mb-10 md:mb-14">
        <p class="rotulo text-ciano">Realização</p>
        <h2 class="mt-3 font-display text-4xl leading-[1.1] font-bold md:text-5xl">
          Quem organiza
        </h2>
      </div>
      <ul class="flex flex-wrap gap-4">
        {realizacao.map((r) => (
          <li class="rounded-2xl border border-dashed border-white/40 px-5 py-4 text-sm font-medium text-suave">
            {r}
            <span class="sr-only"> (logo a inserir)</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" aria-labelledby="faq-t" class="mx-auto max-w-4xl px-5 py-20 md:px-10">
    <Titulo rotulo="Dúvidas" id="faq-t" centro>
      Perguntas frequentes
    </Titulo>
    <div class="flex flex-col gap-3">
      {faq.map((f) => (
        <details class="group vidro rounded-2xl px-6">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 text-lg font-semibold [&::-webkit-details-marker]:hidden">
            {f.p}
            <span
              class="grid size-8 shrink-0 place-items-center rounded-full bg-white/10 text-xl transition-transform group-open:rotate-45"
              aria-hidden="true"
            >
              +
            </span>
          </summary>
          <p class="pb-5 text-suave">{f.r}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="mx-auto max-w-7xl px-5 pb-20 md:px-10">
    <div class="flex flex-col items-start gap-6 rounded-3xl bg-linear-to-r from-acao-1 to-acao-2 px-8 py-12 text-sobre-acao md:flex-row md:items-center md:justify-between md:px-14">
      <p class="font-display text-3xl leading-tight font-extrabold md:text-5xl">
        Garanta sua vaga
        <br />
        no minicurso.
      </p>
      <a href="/inscricao" class="btn-escuro">
        Fazer inscrição
      </a>
    </div>
  </section>
</Base>
